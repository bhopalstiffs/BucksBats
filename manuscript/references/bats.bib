}

@article{singaravelanMoonlightInhibitsLunar2002,
  title = {Moonlight Inhibits and Lunar Eclipse Enhances Foraging Activity of Fruit Bats in an Orchard},
  author = {Singaravelan, N and Marimuthu, G},
  year = 2002,
  journal = {Current Science},
  volume = {82},
  number = {8},
  pages = {1020--1022},
  abstract = {We studied the effect of the lunar eclipse that occurred on 9 January 2001, on the foraging activity pattern of fruit bats in an orchard under natural conditions. In addition, we observed bats when foraging on ripe black grapes Vitis vinifera for three days before and three days after the eclipse. The number of bat-visits was continuously recorded every hour between 1800 and 0600 h. A bat-visit indicates an individual bat either flying towards or away from the orchard. The total number of bat-visits during the night of the lunar eclipse was significantly higher compared to both the pre- and post-lunar eclipse days. There was no significant difference in the intensity of foraging between the pre- and post-lunar eclipse days. We captured short-nosed fruit bats Cynopterus sphinx using mist nets that were set in the vicinity of the orchard.},
  isbn = {0011-3891},
  langid = {english},
  keywords = {behavior,chiroptera,cynopterus sphinx,risk,Science & Technology - Other Topics}
}

@article{skalakSamplingPeriodSize2012,
